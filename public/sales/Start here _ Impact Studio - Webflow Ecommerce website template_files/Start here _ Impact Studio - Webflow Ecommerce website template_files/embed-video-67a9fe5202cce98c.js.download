  --size: ${e=>e.size};

  appearance: none;
  background: none;
  border: none;
  padding: 0;
  box-shadow: var(--lns-shadow-small);
  width: var(--size);
  height: var(--size);
  border-radius: 100%;
  transition: ${200}ms transform;
  cursor: pointer;

  .LayersContainer:hover & {
    transform: scale(1.1);
  }

  /* "Full video" / "Highlights" faces (LOOM_HIGHLIGHTS_OVERVIEW_TAB). They
     fill the PlayControl wrapper, which owns the hover and press scaling. */
  &[data-variant] {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    border: 2px solid var(--play-button-mode-border-color, #4688ec);
    background-color: var(
      --play-button-mode-background-color,
      rgb(24 104 219 / 0.8)
    );
    backdrop-filter: blur(2px);
    box-shadow: none;
    color: var(--play-button-mode-icon-color, white);
    transition:
      background-color ${l8},
      border-color ${l8},
      backdrop-filter ${l8};
  }

  .LayersContainer:hover &[data-variant] {
    transform: none;
  }

  &[data-variant='highlights'] {
    border-color: var(--play-button-mode-border-color, transparent);
    background-color: var(
      --play-button-mode-background-color,
      rgb(0 0 0 / 0.58)
    );
    backdrop-filter: blur(6px);
  }
