    query GetUserByIdWithProfile($userId: ID!) {
  user: getUserById(userId: $userId) {
    __typename
    ... on RegularUserPayload {
      user {
        id
        email
        first_name
        last_name
        avatars {
          thumb
          large
          isAtlassianMastered
        }
        profile {
          profileUrl
          profileVideoCount
          communityVideoCount
          profileInfo {
            role
            location
          }
        }
      }
    }
    ... on CommunityUserPayload {
      user {
        id
        first_name
        last_name
        avatars {
          thumb
          large
        }
        profile {
          profileUrl
          communityVideoCount
          profileInfo {
            role
            location
          }
        }
      }
    }
  }
}
