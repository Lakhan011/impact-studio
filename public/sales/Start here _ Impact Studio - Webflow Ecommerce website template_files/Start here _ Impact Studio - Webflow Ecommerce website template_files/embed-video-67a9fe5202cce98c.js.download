    query getCcpBillingDetails($workspaceId: ID!, $offeringKey: String) {
  getCcpBillingDetails(workspaceId: $workspaceId, offeringKey: $offeringKey) {
    __typename
    ... on GetCcpBillingDetailsPayload {
      tenantContexts {
        orgId
        entitlementInfo {
          entitlementId
          entitlement {
            transactionAccount {
              id
              isCurrentUserBillingAdmin
            }
            preDunning {
              status
            }
            subscription {
              status
              billingPeriodDetails {
                billingAnchorTimestamp
                nextBillingTimestamp
              }
              accountDetails {
                invoiceGroup {
                  invoiceable
                  experienceCapabilities {
                    configurePaymentV2 {
                      experienceUrl
                      isAvailableToUser
                    }
                  }
                }
              }
              trial {
                timeLeft
                startTimestamp
                endBehaviour
              }
              chargeDetails {
                chargeQuantities {
                  chargeElement
                  lastUpdatedAt
                  quantity
                }
              }
              endTimestamp
              scheduledChanges {
                phases {
                  subscriptionScheduleAction
                }
              }
            }
            offering {
              id
              name
              sku
              productKey
              pricingType
              level
            }
            relatesFromEntitlements {
              relationshipType
              offeringName
            }
            experienceCapabilities {
              manageEntitlement {
                experienceUrl
                isAvailableToUser
              }
              compareOfferings {
                experienceUrl
                isAvailableToUser
              }
              changeOfferingV2 {
                experienceUrl
                isAvailableToUser
              }
              placeOrderBusiness {
                experienceUrl
                isAvailableToUser
              }
              placeOrderBusinessAI {
                experienceUrl
                isAvailableToUser
              }
            }
          }
        }
      }
    }
  }
}
