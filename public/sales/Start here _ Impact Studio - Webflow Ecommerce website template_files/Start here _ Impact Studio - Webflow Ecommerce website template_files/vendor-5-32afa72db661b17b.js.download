",description:"Label to indicate that the user is a bot account"},viewManagerProfile:{id:"pt.profile-card.view-manager-profile",defaultMessage:"View {name} profile",description:"Accessible label for the button to view the manager's profile"}});r.d(t,{},{A:n})},874435(e,t,r){r.d(t,{O:()=>o,X:()=>c});var n=r(745975),a=r(435226),i=r(66504),o=function(e){var t=e.children,r=e.role,o=e.testId,c=e.labelledBy,s=e.ariaLabel;return n.createElement(i.Box,{xcss:(0,a.cx)("_1bsb1gwv"),backgroundColor:"elevation.surface.overlay",role:r,testId:o,"aria-labelledby":c,"aria-label":s},t)},c=function(e){var t=e.children,r=e.testId;return n.createElement(i.Box,{testId:r,xcss:(0,a.cx)("_4cvr1h6o _1e0c1txw _4t3i16xz _1bah1h6o _kqswh2mm")},t)}},672305(e,t,r){var n={packageName:"@atlaskit/profilecard",packageVersion:"27.1.31"};r.d(t,{Fc:()=>"rovoAgentProfilecard",HD:()=>"profilecard",NZ:()=>"teamProfileCard",uJ:()=>n})},179207(e,t,r){var n=r(672305),a=function(e){switch(e){case"user":return n.HD;case"team":return n.NZ;case"agent":return n.Fc;default:return"user"}};r.d(t,{V:()=>a})},782783(e,t,r){var n="u">typeof window&&"performance"in window&&!!performance.now,a=Date.now(),i=function(){return n?performance.now():Date.now()-a};r.d(t,{d:()=>i})},81643(e,t,r){var n="ari:cloud:identity::user/",a=function(e){return e.replace(n,"")};r.d(t,{V:()=>a,m:()=>n})},624298(e,t,r){r.d(t,{A:()=>c});var n=r(729707),a=r(745975),i={default:"_bfhki8nm",success:"_bfhki8nm",inverse:"_bfhk1vck"},o={default:"_bfhk1aqn",success:"_bfhkkcmj",inverse:"_bfhkvuon"};let c=function(e){var t=e.appearance,r=void 0===t?"default":t,c=e.ariaLabel,s=e.isIndeterminate,l=void 0!==s&&s,u=e.testId,d=e.value,f=void 0===d?0:d,p=l?0:Math.max(0,Math.min(f,1));return a.createElement("div",{role:"progressbar","aria-label":c,"aria-valuemin":0,"aria-valuenow":p,"aria-valuemax":1,"data-testid":void 0===u?"progress-bar":u,className:(0,n.A)(["_2rko1rr0 _1reo15vq _18m915vq _1bsb1osq _4t3ii2wt _kqswh2mm _bfhki8nm",i[r]])},l?a.createElement(a.Fr