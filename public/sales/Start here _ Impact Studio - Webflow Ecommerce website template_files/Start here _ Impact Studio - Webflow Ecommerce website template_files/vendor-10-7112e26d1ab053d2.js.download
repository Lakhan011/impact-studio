:"Option label for the default Rovo response tone."},toneRovoDefaultDescription:{id:"rovo-personalization.response-style-tab.toneRovoDefaultDescription",defaultMessage:"Collaborative and team-oriented",description:"Description for the default Rovo response tone option card."},toneProfessional:{id:"rovo-personalization.response-style-tab.toneProfessional",defaultMessage:"Professional",description:"Option label for a professional Rovo response tone."},toneProfessionalDescription:{id:"rovo-personalization.response-style-tab.toneProfessionalDescription",defaultMessage:"Straightforward and polished",description:"Description for the professional Rovo response tone option card."},toneCreative:{id:"rovo-personalization.response-style-tab.toneCreative",defaultMessage:"Creative",description:"Option label for a creative Rovo response tone."},toneCreativeDescription:{id:"rovo-personalization.response-style-tab.toneCreativeDescription",defaultMessage:"Focused on exploring fresh ideas",description:"Description for the creative Rovo response tone option card."},toneEmpathetic:{id:"rovo-personalization.response-style-tab.toneEmpathetic",defaultMessage:"Empathetic",description:"Option label for an empathetic Rovo response tone."},toneEmpatheticDescription:{id:"rovo-personalization.response-style-tab.toneEmpatheticDescription",defaultMessage:"Supportive, thoughtful, and practical",description:"Description for the empathetic Rovo response tone option card."},characteristicsSectionTitle:{id:"rovo-personalization.response-style-tab.characteristicsSectionTitle",defaultMessage:"Response characteristics",description:"Title of the section for choosing response characteristics such as length and structure."},neutral:{id:"rovo-personalization.response-style-tab.neutral",defaultMessage:"Neutral",description:"Option label for a response characteristic with no directional preference."},tldrLabel:{id:"rovo-personalization.response-style-tab.tldrLabel",defaultMessage:"TLDR",description:'Label for 