jectCardMessages.claimProjectDescription"},claimProject:{defaultMessage:"Claim this project",description:"Action that promotes an inferred project to an Atlas project",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.claimProject"},claimProjectError:{defaultMessage:"Error. Try again later.",description:"Error shown when an inferred project cannot be promoted",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.claimProjectError"},viewProject:{defaultMessage:"View project",description:"Action that opens the promoted Atlas project",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.viewProject"},copyLink:{defaultMessage:"Copy link",description:"Action that copies the promoted Atlas project link",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.copyLink"},linkCopied:{defaultMessage:"Link copied",description:"Confirmation shown after the promoted Atlas project link is copied",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.linkCopied"},project:{defaultMessage:"Project",description:"Label shown after an inferred project has been promoted",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.project"},projectTrigger:{defaultMessage:"{projectName}: Project",description:"Accessible label for the project chip after promotion",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.projectTrigger"},sourcesAndRelatedLinks:{defaultMessage:"Sources and related links",description:"Action that shows the source links for a promoted project",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.sourcesAndRelatedLinks"},owner:{defaultMessage:"Owner",description:"Heading for the promoted project owner",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.owner"},contributors:{defaultMessage:"Contributors",description:"Heading for the promoted project contributors",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.contributors"},noContributors:{defaultMessage:"No contributors",description:"Empty state for the promoted project contributors",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.noContributors"},projectConfirmed:{defaultMessage:"Project confirmed",description:"Confirmation shown after an inferred project is promoted",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.projectConfirmed"},relatedContent:{defaultMessage:"Related content ({numRelated})",description:"Heading for the section listing documents, issues and pull requests related to the inferred project",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.relatedContent"},aiDisclaimer:{defaultMessage:"Uses AI. Verify results.",description:"Disclaimer in the inferred project card footer indicating AI-generated content",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.aiDisclaimer"},goodSuggestion:{defaultMessage:"Good suggestion",description:"Accessible label and tooltip for giving positive feedback on a suggested project in its card",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.goodSuggestion"},poorSuggestion:{defaultMessage:"Poor suggestion",description:"Accessible label and tooltip for giving negative feedback on a suggested project in its card",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.poorSuggestion"},feedbackThankYou:{defaultMessage:"Thank you for your feedback!",description:"Confirmation shown after the user gives feedback on a suggested project",id:"rovo-platform-ui-components.inferred-project-card.inferredProjectCardMessages.feedbackThankYou"},dismissFeedbackConfirmation:{defaultMessage:"Dismiss",description:"Accessible label for the button that closes the feedback confirmat