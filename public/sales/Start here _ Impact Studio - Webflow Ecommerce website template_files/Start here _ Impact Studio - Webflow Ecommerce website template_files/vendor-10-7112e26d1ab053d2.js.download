Message:"Update work items in this board.",description:"The third prompt option in the empty state of the chat history when viewing a Jira board"},jiraBoardPrompt4:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-4",defaultMessage:"What are the risks for this active sprint?",description:"The fourth prompt option in the empty state of the chat history when viewing a Jira board"},jiraBoardPrompt5:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-5",defaultMessage:"How many work items are unassigned in this board?",description:"Conversation starter shown in Rovo Chat on Jira boards that asks Rovo to count unassigned work items on the current board."},jiraBoardPrompt6:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-6",defaultMessage:"Which work items are stale?",description:"Conversation starter shown in Rovo Chat on Jira boards that asks Rovo to find stale work items on the current board."},jiraBoardPrompt7:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-7",defaultMessage:"Which work items are blocked?",description:"Conversation starter shown in Rovo Chat on Jira boards that asks Rovo to find blocked work items on the current board."},jiraBoardPrompt8:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-8",defaultMessage:"Summarize this board for me.",description:"Conversation starter shown in Rovo Chat on Jira boards that asks Rovo to summarize the current board."},jiraBoardPrompt9:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-9",defaultMessage:"Update work items on this board.",description:"Conversation starter shown in Rovo Chat on Jira boards that asks Rovo to update work items on the current board."},jiraBoardPrompt10:{id:"rovo-conversation-actions.conversation-starters.jira-board.starter-10",defaultMessage:"Move work items to a status.",description:"Conversation starter shown in Rovo Chat on Jira boards that asks Rovo to move work items on the current board to a status."},jiraBacklogPrompt1:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-1",defaultMessage:"Find work items assigned to me in this backlog.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to show items assigned to the current user in this backlog."},jiraBacklogPrompt2:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-2",defaultMessage:"Update the status of a set of work items in this backlog to `status`.",description:'Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to update the status of backlog items. The word `status` inside backticks is a free-text placeholder — the user replaces it in the chat editor with a specific status (e.g. "In Progress", "Done") before sending. Do not translate the backticks or the placeholder token `status`.'},jiraBacklogPrompt3:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-3",defaultMessage:"Add the top-ranked work items from this backlog to the upcoming sprint.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to move the top-ranked work items (highest position in the backlog order) into the next sprint."},jiraBacklogPrompt4:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-4",defaultMessage:"Create new work items in the backlog.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to create new issues in the backlog."},jiraBacklogPrompt7:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-7",defaultMessage:"Move a set of work items in this backlog to the upcoming sprint.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to move a set of work items in the backlog into the next sprint."},jiraBacklogPrompt8:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-8",defaultMessage:"Write a description for a `Jira work item`.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to write a description for a backlog item. The phrase `Jira work item` inside backticks is a link placeholder — the user replaces it in the chat editor with a specific issue via the link/mention typeahead (e.g. TREX-586) before sending. Do not translate the backticks or the placeholder token `Jira work item`."},jiraBacklogPrompt9:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-9",defaultMessage:"Update the summary for a set of work items in this backlog.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to update the summary/title of a set of work items in the backlog."},jiraBacklogPrompt10:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-10",defaultMessage:"Update the priority of a set of work items in this backlog to `priority`.",description:'Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to update the priority of a set of work items in the backlog. The word `priority` inside backticks is a free-text placeholder — the user replaces it in the chat editor with a specific priority (e.g. "High", "Medium", "Low") before sending. Do not translate the backticks or the placeholder token `priority`.'},jiraBacklogPrompt11:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-11",defaultMessage:"Update the parent for a set of work items in this backlog.",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to update the parent issue of work items in this backlog."},jiraBacklogPrompt12:{id:"rovo-conversation-actions.conversation-starters.jira-backlog.starter-12",defaultMessage:"Are there any Jira issues not connected to a parent issue?",description:"Conversation starter shown in Rovo Chat on Jira backlog that asks Rovo to find orphaned items with no parent."},jiraBacklogPrompt13:{id:"rovo-conversation-actions.