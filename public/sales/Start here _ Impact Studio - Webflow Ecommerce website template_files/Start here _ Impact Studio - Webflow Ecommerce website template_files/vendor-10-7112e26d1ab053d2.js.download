,tip:{id:"smart-creation.preview.loading.tip",defaultMessage:"Tip",description:"Label for the lozenge to show before a tip in the loading state"},remember:{id:"smart-creation.preview.loading.remember",defaultMessage:"Remember",description:"Label for the lozenge to show before something to remember in the loading state"},helpfulMessage1:{id:"smart-creation.preview.loading.helpful.message.1",defaultMessage:"You can tell Rovo the tone you’re looking for, such as professional, casual, or empathetic.",description:"Helpful message in the loading state"},helpfulMessage2:{id:"smart-creation.preview.loading.helpful.message.2",defaultMessage:"It helps to describe your intended audience (ex: executives, developers, students) so Rovo can tailor results to their needs.",description:"Helpful message in the loading state"},helpfulMessage3:{id:"smart-creation.preview.loading.helpful.message.3",defaultMessage:"For quicker, super-focused results, add length limits like “in 3 bullet points” or “under 150 words.”",description:"Helpful message in the loading state"},helpfulMessage4:{id:"smart-creation.preview.loading.helpful.message.4",defaultMessage:"Tell Rovo what you’re hoping to achieve with your work. Do you want to inform, persuade, summarize, or brainstorm?",description:"Helpful message in the loading state"},helpfulMessage5:{id:"smart-creation.preview.loading.helpful.message.5",defaultMessage:"You can chat with Rovo using the same words and phrases you would when talking to a friend or colleague.",description:"Helpful message in the loading state"},helpfulMessage6:{id:"smart-creation.preview.loading.helpful.message.6",defaultMessage:"For best results, give Rovo a role - such as a “project manager” or “proofreader” - so it can respond from that unique point of view.",description:"Helpful message in the loading state"},helpfulMessage7:{id:"smart-creation.preview.loading.helpful.message.7",defaultMessage:"Additional examples and source material help Rovo give its best possible results.",description:"Helpful message in the loading state"},helpfulMessage8:{id:"smart-creation.preview.loading.helpful.message.8",defaultMessage:"You can ask Rovo to turn text into tables, tables into lists, or a collection of whiteboard stickies into a document.",description:"Helpful message in the loading state"},helpfulMessage9:{id:"smart-creation.preview.loading.helpful.message.9",defaultMessage:"Rovo can search and pull insights from many of the tools you use alongside Confluence, like Gmail, OneDrive, Asana, Notion and Slack.",description:"Helpful message in the loading state"},helpfulMessage10:{id:"smart-creation.preview.loading.helpful.message.10",defaultMessage:"You can always tell Rovo to “make it shorter”, “add examples”, or anything else to fine-tune your work.",description:"Helpful message in the loading state"},helpfulMessage11:{id:"smart-creation.preview.loading.helpful.message.11",defaultMessage:"You can ask Rovo to explain its thinking anytime.",description:"Helpful message in the loading state"},helpfulMessage12:{id:"smart-creation.preview.loading.helpful.message.12",defaultMessage:"Make sure to verify critical data. Like all AI tools, Rovo sometimes makes mistakes.",description:"Helpful message in the loading state"},helpfulMessage13:{id:"smart-creation.preview.loading.helpful.message.13",defaultMessage:"Rovo can translate long, technical documents into easily scannable insights for stakeholders.",description:"Helpful message in the loading state"}}),b=[{lozenge:v.tip,message:v.helpfulMessage1},{lozenge:v.tip,message:v.helpfulMessage2},{lozenge:v.tip,message:v.helpfulMessage3},{lozenge:v.tip,message:v.helpfulMessage4},{lozenge:v.remember,message:v.helpfulMessage5},{lozenge:v.tip,message:v.helpfulMessage6},{lozenge:v.tip,message:v.helpfulMessage7},{lozenge:v.tip,message:v.helpfulMessage8},{lozenge:v.remember,message:v.helpfulMessage9},{lozenge:v.remember,message:v.helpfulMessage10},{lozenge:v.tip,message:v.helpfulMessage11},{lozenge:v.remember,messa