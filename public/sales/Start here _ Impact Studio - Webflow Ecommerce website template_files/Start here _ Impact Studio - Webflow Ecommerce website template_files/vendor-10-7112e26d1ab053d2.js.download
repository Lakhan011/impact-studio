}`,l=`#version 300 es
precision highp float;
precision highp int;
uniform vec2 resolution;
uniform vec2 size;
uniform vec2 pointer;
out vec4 fragColor;

vec3 wavelengthColor(float wavelength) {
  vec3 response = (vec3(wavelength) - vec3(0.610, 0.545, 0.460)) / vec3(0.045, 0.038, 0.032);
  float visible = smoothstep(0.380, 0.410, wavelength) * (1.0 - smoothstep(0.700, 0.780, wavelength));
  return exp(-0.5 * response * response) * visible;
}

vec3 diffraction(vec2 across, vec2 lightAndView, float spacing) {
  float pathDifference = spacing * abs(dot(lightAndView, across));
  float along = dot(lightAndView, vec2(-across.y, across.x));
  float envelope = exp(-along * along / 0.36);
  vec3 reflected = vec3(0.0);
  for (int order = 1; order <= 3; order++) {
    float m = float(order);
    reflected += wavelengthColor(pathDifference / m) / (m * m);
  }
  return reflected * envelope;
}

vec3 pearlColor(float phase) {
  return vec3(0.55, 0.52, 0.64) + vec3(0.43, 0.40, 0.34)
    * cos(6.2831853 * (phase + vec3(0.05, 0.38, 0.63)));
}

float grain(vec2 point) {
  uvec2 p = uvec2(abs(point) * 2400.0);
  uint n = (p.x * 1597334677u) ^ (p.y * 3812015801u);
  n = (n ^ (n >> 16u)) * 2246822519u;
  return float(n & 1023u) / 1023.0 - 0.5;
}

float etchedPhase(vec2 p) {
  vec2 warp = vec2(sin(p.y * 7.0 + sin(p.x * 4.0)) * 0.085,
    sin(p.x * 6.0 - p.y * 3.0) * 0.07);
  vec2 q = p + warp - vec2(0.13, 0.08);
  float radius = length(q * vec2(1.0, 0.76));
  return radius * 142.0 + sin(atan(q.y, q.x) * 3.0 + radius * 8.0) * 1.7;
}

void main() {
  vec2 uv = vec2(gl_FragCoord.x / resolution.x, 1.0 - gl_FragCoord.y / resolution.y);
  vec2 pixel = uv * size;
  // Fixed physical scale keeps the wide example and the short cover consistent.
  // Stretch the reflection independently from the unchanged dotted grid.
  vec2 materialScale = vec2(1.82 / 357.5, 1.82 / 504.0);
  vec2 p = (pixel - size * 0.5) * materialScale;
  vec2 lightCenter = (pointer - 0.5) * size * materialScale;
  vec2 delta = p - lightCenter;
  float sweepDistance = delta.x * 0.72 + delta.y * 0.52 + sin(p.y * 4.0 + p.x * 3.0) * 0.08;
  float bandDistance = sweepDistance / 0.36;
  float lightBand = exp(-bandDistance * bandDistance);
  float glintDistance = sweepDistance / 0.085;
  float glint = exp(-glintDistance * glintDistance);
  vec2 falloff = delta * vec2(1.05, 0.72);
  float spotlight = exp(-dot(falloff, falloff) * 2.6);
  float light = lightBand * spotlight;
  vec3 lightDirection = normalize(vec3(lightCenter - p, 1.2));
  vec3 viewDirection = normalize(vec3(-p, 4.5));
  vec2 lightAndView = (lightDirection + viewDirection).xy;
  float illumination = lightDirection.z * viewDirection.z;
  vec3 tint = vec3(0.72, 0.76, 0.8);
  float noise = grain(p + vec2(2.0));
  vec3 color = light * (vec3(0.045) + tint * 0.065);
  color += noise * light * 0.085;

  // The wavy phase changes diffraction direction, but does not draw a radial pattern.
  float contour = etchedPhase(p);
  vec2 dx = dFdx(p);
  vec2 dy = dFdy(p);
  vec2 gradient = vec2(dFdx(contour) * dy.y - dFdy(contour) * dx.y,
    dFdy(contour) * dx.x - dFdx(contour) * dy.x);
  vec2 across = gradient / max(length(gradient), 0.00000001);
  vec3 spectral = diffraction(across, lightAndView, 1.65) * illumination;
  float reveal = 0.06 + 0.24 * spotlight + light * 1.15;
  float pearlPhase = dot(lightAndView, vec2(0.48, -0.32)) + p.y * 0.32 + contour * 0.003;
  vec3 pearl = pearlColor(pearlPhase);
  color += pearl * light * 0.24;
  color += (pearl * 0.5 + vec3(0.5)) * glint * spotlight * 0.12;
  float sparkle = pow(max(noise + 0.5, 0.0), 24.0) * glint * spotlight;
  color += pearl * sparkle * 0.22;
  color *= 1.2;

  // Match CardCoverArtwork: 20px square cells, 4px dots, 1.25px round strokes.
  vec2 horizontal = mod(pixel - vec2(24.0) + vec2(2.0, 10.0), vec2(4.0, 20.0)) - vec2(2.0, 10.0);
  vec2 vertical = mod(pixel - vec2(24.0) + vec2(10.0, 2.0), vec2(20.0, 4.0)) - vec2(10.0, 2.0);
  float distance = min(length(horizontal), length(vertical));
  float aa = size.x / resolution.x * 0.5;
  float dots = 1.0 - smoothstep(0.625 - aa, 0.625 + aa, distance);
  vec3 foil = vec3(0.12, 0.14, 0.18) + pearl * 0.65 + spectral * 0.12;
  // Keep the grid's reflected light subtle without dimming the pearlescent wash.
  color += dots * foil * reveal * 0.25;
  fragColor = vec4(max(color, vec3(0.0)), 1.0);
}`,u=n(547190).A,d=1e3/30;function p(){var e,t=(e=(0,a.useRef)(null),(0,a.useEffect)(function(){var t=e.current,n=null==t?void 0:t.closest("[data-rovo-holographic-effect]");if(t&&n){var r=null,a=null,o=null,i=-1/0,p=null,f=0,m=!0,g=!1,h=t.ownerDocument,v=window.matchMedia("(prefers-reduced-motion: reduce)"),b=window.matchMedia("(forced-colors: active)"),y=function(){null!==a&&(cancelAnimationFrame(a),a=null),null!==o&&(clearTimeout(o),o=null)},C=function(){if(a=null,!h.hidden&&m&&!b.matches&&!g){var e,o=function(e,t,n){var r=getComputedStyle(t),a=Number(r.getPropertyValue("--cosmos-active")),o=Number(r.getPropertyValue("--cosmos-focus"));if(!a&&!o)return null;var i=e.getBoundingClientRect();if(!i.width||!i.height)return null;if(n||!a)return{width:i.width,height:i.height,lightX:.5,lightY:.5};var s=t.getBoundingClientRect(),c=parseFloat(r.getPropertyValue("--cosmos-x"))||0,l=parseFloat(r.getPropertyValue("--cosmos-y"))||0;return{width:i.width,height:i.height,lightX:(s.left+c/100*s.width-i.left)/i.width,lightY:(s.top+l/100*s.height-i.top)/i.height}}(t,n,v.matches);if(o){var s=o.width,u=o.height,d=o.lightX,y=o.lightY;if((null==(e=p)?void 0:e.width)!==s||p.height!==u||p.lightX!==d||p.lightY!==y){if(r||(f=performance.now(),r=function(e){var t=e.getContext("webgl2",{alpha:!0,antialias:!1,depth:!1,stencil:!1,failIfMajorPerformanceCaveat:!0,powerPreference:"low-power"});if(!t)return null;var n=function(e,n){var r=t.createShader(e);return r?(t.shaderSource(r,n),t.compileShader(r),r):null},r=n(t.VERTEX_SHADER,c),a=n(t.FRAGMENT_SHADER,l),o=t.createProgram();if(!r||!a||!o)return r&&t.deleteShader(r),a&&t.deleteShader(a),o&&t.deleteProgram(o),null;t.attachShader(o,r),t.attachShader(o,a),t.linkProgram(o),t.deleteShader(r),t.deleteShader(a);var i=t.getExtension("KHR_parallel_shader_compile"),s=!1,u=!1,d=null,p=null,f=null;return{draw:function(n,r,a,c){if(u)return"unavailable";if(!s){if(i&&!t.getProgramParameter(o,i.COMPLETION_STATUS_KHR))return"pending";if(!t.getProgramParameter(o,