html[data-color-mode="light"][data-theme~="light:UNSAFE-dynamic"], [data-subtree-theme][data-color-mode="light"][data-theme~="light:UNSAFE-dynamic"],
html[data-color-mode="dark"][data-theme~="dark:UNSAFE-dynamic"], [data-subtree-theme][data-color-mode="dark"][data-theme~="dark:UNSAFE-dynamic"] {
  color-scheme: light;
  --ds-dynamic-color-background-subtle: oklch(from var(--ds-dynamic-background, #000000) calc(l - (0.03 * max(0, sign(l - 0.9 + 0.0001))) + (0.03 * max(0, sign(0.9 - l - 0.0001) * sign(l - 0.5 + 0.0001))) - (0.03 * max(0, sign(0.5 - l - 0.0001) * sign(l - 0.3 - 0.0001))) + (0.03 * 2 * max(0, sign(0.3 - l + 0.0001)))) c h);
