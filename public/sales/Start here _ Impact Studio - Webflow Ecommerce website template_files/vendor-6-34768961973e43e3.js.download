  --ds-dynamic-color-foreground-subtlest: oklch(from var(--ds-dynamic-foreground, #FFFFFF) calc(l - (0.15 * max(0, sign(l - 0.9 + 0.0001))) + (0.15 * max(0, sign(0.9 - l - 0.0001) * sign(l - 0.5 + 0.0001))) - (0.15 * max(0, sign(0.5 - l - 0.0001) * sign(l - 0.3 - 0.0001))) + (0.15 * 2 * max(0, sign(0.3 - l + 0.0001)))) c h);
