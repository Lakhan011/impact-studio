:{id:"agent-studio-skills.import-skill.retryNameCheckLabel",defaultMessage:"Retry name check",description:"Retries a failed skill name availability check."},alreadySavedTitle:{id:"agent-studio-skills.import-skill.alreadySavedTitle",defaultMessage:"This skill name is already taken. Choose a different name to continue.",description:"Information shown above an uploaded skill preview when the skill is already saved."},duplicateCheckError:{id:"agent-studio-skills.import-skill.duplicateCheckError",defaultMessage:"We couldn't check whether this skill name is available. Try again.",description:"Error shown when the library duplicate check fails before showing the upload preview."},modalTitle:{id:"agent-studio-skills.import-skill.modalTitle",defaultMessage:"Upload skill",description:"Title of the modal for importing a standalone SKILL.md file."},modalDescription:{id:"agent-studio-skills.import-skill.modalDescription",defaultMessage:"One Markdown file. ZIP files aren't supported.",description:"Supported upload format guidance in the skill import modal."},dropTitle:{id:"agent-studio-skills.import-skill.dropTitle",defaultMessage:"Drop a Markdown file here",description:"Title of the skill file drop zone."},dropDescription:{id:"agent-studio-skills.import-skill.dropDescription",defaultMessage:"or choose a file from your computer",description:"Supporting text in the skill file drop zone."},chooseFileLabel:{id:"agent-studio-skills.import-skill.chooseFileLabel",defaultMessage:"Choose file",description:"Label for the file picker button."},invalidFileError:{id:"agent-studio-skills.import-skill.invalidFileError",defaultMessage:"Select a Markdown file named SKILL.md. Other Markdown files cannot be imported.",description:"Error shown when the selected file is not a standalone SKILL.md file."},multipleFilesError:{id:"agent-studio-skills.import-skill.multipleFilesError",defaultMessage:"Select only one SKILL.md file.",description:"Error shown when more than one file is dropped into the skill import flow."},readingFileStatus:{id:"agent-studio-skills.import-skill.readingFileStatus",defaultMessage:"Reading SKILL.md…",description:"Status shown while the selected skill file is being read."},emptySkillFileTitle:{id:"agent-studio-skills.import-skill.emptySkillFileTitle",defaultMessage:"Something doesn’t look right",description:"Heading in the empty skill file error state."},uploadLabel:{id:"agent-studio-skills.import-skill.uploadLabel",defaultMessage:"Upload",description:"Action to choose a replacement file after an empty skill upload."},emptySkillFileError:{id:"agent-studio-skills.import-skill.emptySkillFileError",defaultMessage:"The file you uploaded appears to be empty. Try again with a different {extension} file.",description:"Error shown when the selected skill file is empty or contains only whitespace."},fileReadError:{id:"agent-studio-skills.import-skill.fileReadError",defaultMessage:"We could not read that file. Try choosing it again.",description:"Error shown when the browser cannot read the selected skill file."},fileTooLargeError:{id:"agent-studio-skills.import-skill.fileTooLargeError",defaultMessage:"Select a SKILL.md file no larger than 2 MB.",description:"Error shown when the selected skill file is too large to preview safely."},instructionsLabel:{id:"agent-studio-skills.import-skill.instructionsLabel",defaultMessage:"Instructions",description:"Heading above the selected SKILL.md content preview."},replaceFileLabel:{id:"agent-studio-skills.import-skill.replaceFileLabel",defaultMessage:"Replace file",description:"Label for replacing the selected SKILL.md file."},cancelLabel:{id:"agent-studio-skills.import-skill.cancelLabel",defaultMessage:"Cancel",description:"Label for dismissing the skill import modal."},importUnavailableDescription:{id:"agent-studio-skills.import-skill.importUnavailableDescription",defaultMessage:"Importing will be available when the upload service is connected.",description:"Explanation shown when no import handler is supplie