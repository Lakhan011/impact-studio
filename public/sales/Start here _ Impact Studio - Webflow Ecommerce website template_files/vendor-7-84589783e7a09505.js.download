 radi ovdje.","search_ai.ai_answer_component_error_state_subjective_query":"Čini se da je to subjektivno pitanje, tako da {brandName} trenutačno nema odgovor.","search_ai.ai_answer_component_feedback_flag_descriptionl":"Cijenimo što ste odvojili vrijeme za slanje ovih povratnih informacija","search_ai.ai_answer_component_feedback_label":"Je li ovo bilo korisno?","search_ai.ai_answer_component_followups_label":"Postavite dodatno pitanje","search_ai.ai_answer_component_hipaa_compliance_link":"Saznajte više o HIPAA-i","search_ai.ai_answer_component_information_icon_tooltip_link":"Saznajte zašto","search_ai.ai_answer_component_information_icon_tooltip_text":"Kvaliteta informacija može varirati. {informationLink}","search_ai.ai_answer_component_like_button_tooltip":"Dobar odgovor","search_ai.ai_answer_component_open_ai_rate_limit_error":"Otkrivena je prekomjerna upotreba s {brandName}. Pokušajte ponovno poslije. Pročitajte više u {supportLink}.","search_ai.ai_answer_component_report_button":"Prijavite ovo","search_ai.ai_answer_component_report_consent_checkbox_label":"Uključite moj posljednji upit i odgovor u povratnim informacijama.","search_ai.ai_answer_component_report_details_label":"Opišite problem","search_ai.ai_answer_component_report_empty_option_label":"Želim prijaviti...","search_ai.ai_answer_component_report_empty_option_share_label":"Želim podijeliti...","search_ai.ai_answer_component_report_inaccurate_option_label":"Ovo je netočno ili obmanjujuće","search_ai.ai_answer_component_report_modal_title":"Pomozite da poboljšamo {featureTitle}","search_ai.ai_answer_component_report_offensive_option_label":"Ovo je uvredljivo ili štetno","search_ai.ai_answer_component_report_other_option_label":"Nešto drugo","search_ai.ai_answer_component_report_relevance_option_label":"Ovo nije relevantno ili nije očekivano","search_ai.ai_answer_component_report_success_text":"Prijava poslana","search_ai.ai_answer_component_report_summary_label":"Je li bilo problema s odgovorom? Reci