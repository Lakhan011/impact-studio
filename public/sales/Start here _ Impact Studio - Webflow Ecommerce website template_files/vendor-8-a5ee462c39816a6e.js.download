pose is to provide users with a way to remove conversations they no longer need."},lastMessageTimestampWithSeparator:{id:"ai-mate.all-chat-view.chat-item.last-message-timestamp-with-separator",defaultMessage:"· {lastMessageTimeDelta}",description:'Timestamp text displayed in the footer of a chat conversation list item, prefixed with a middle dot separator. Shown when an agent name precedes it. For example: "· 2 hours ago".'},footerSeparator:{id:"ai-mate.all-chat-view.chat-item.footer-separator",defaultMessage:"·",description:"Middle dot separator used between footer items in a chat conversation list item. For example between agent name, scopes, and timestamp."},scopesOverflowCount:{id:"ai-mate.all-chat-view.chat-item.scopes-overflow-count",defaultMessage:"+{count}",description:'Text showing the number of additional scopes that are not individually displayed in the footer of a chat conversation list item. For example, if 3 of 4 scopes are shown, this displays "+1".'},scopesOverflowAccessibleLabel:{id:"conversation-assistant-ui-components.common.chat-conversation-list-refresh.chat-item.scopesOverflowAccessibleLabel",defaultMessage:"{count, plural, one {# more source} other {# more sources}}",description:"Accessible text that explains how many additional conversation sources are not individually displayed."},imagePreviewTitle:{id:"ai-mate.all-chat-view.chat-item.image-preview-title",defaultMessage:"Image Preview",description:"Title displayed in the modal header when previewing an image from a chat conversation list item."},filePreviewFallbackDescription:{id:"rovo.chat-list.file-preview.fallback-description",defaultMessage:"Preview not available for this file type.",description:"Message displayed in the file preview modal when the file type cannot be previewed inline."},rovoAgentName:{id:"ai-mate.all-chat-view.chat-item.rovo-agent-name",defaultMessage:"Rovo",description:"Accessible name for the default Rovo agent shown in a chat conversation list item."}}),H=["triggerRe