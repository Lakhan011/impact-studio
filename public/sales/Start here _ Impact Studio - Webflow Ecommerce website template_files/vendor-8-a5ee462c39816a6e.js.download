										projectFilter
									}
								}
							}
						}
						mcpServers {
							id
							displayName
							iconUrl
						}
						mcpTools {
							id
							displayName
							iconUrl
						}
						agenticSkills(contextAri: $contextAri) @optIn(to: ["GraphIntegrationSkillItemsQuery"]) {
							id
							name
							description
							uiMetadata {
								displayName
								iconKey
								color
								helpText
							}
						}
						isDeepResearchEnabled
						isWebSearchEnabled
					}
				}
