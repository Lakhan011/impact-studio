-text",defaultMessage:"Desktop app",description:"Text for the header desktop app button"},chatHeaderDesktopAppIconLabel:{id:"ai-mate.rovo-chat-header.desktop-app-icon-label",defaultMessage:"Desktop app",description:"Label for the header desktop app icon"},chatHeaderSlackAppButtonText:{id:"ai-mate.rovo-chat-header.slack-app-button-text",defaultMessage:"Rovo for Slack",description:"Text for the header Rovo for Slack button"},chatHeaderSlackAppIconLabel:{id:"ai-mate.rovo-chat-header.slack-app-icon-label",defaultMessage:"Rovo for Slack",description:"Label for the header Rovo for Slack icon"},chatHeaderTeamsAppButtonText:{id:"ai-mate.rovo-chat-header.teams-app-button-text",defaultMessage:"Rovo for Teams",description:"Text for the header Rovo for Teams button"},chatHeaderTeamsAppIconLabel:{id:"ai-mate.rovo-chat-header.teams-app-icon-label",defaultMessage:"Rovo for Teams",description:"Label for the header Rovo for Teams icon"},chatHeaderChromeExtensionButtonText:{id:"ai-mate.rovo-chat-header.chrome-extension-button-text",defaultMessage:"Chrome Extension",description:"Text for the header chrome extension button"},chatHeaderChromeExtensionIconLabel:{id:"ai-mate.rovo-chat-header.chrome-extension-icon-label",defaultMessage:"Chrome Extension",description:"Label for the header chrome extension icon"},chatHeaderMobileAppButtonText:{id:"ai-mate.rovo-chat-header.mobile-app-button-text",defaultMessage:"Mobile app",description:"Text for the header mobile app button"},chatHeaderMobileAppIconLabel:{id:"ai-mate.rovo-chat-header.mobile-app-icon-label",defaultMessage:"Mobile app",description:"Label for the header mobile app icon"},chatHeaderMoreMenuBackButtonLabel:{id:"ai-mate.rovo-chat-header.more-menu-back-button-label",defaultMessage:"Back",description:"Label for the back button in the more menu sub-menu header"},chatStoreUserMessagesLabel:{id:"ai-mate.chat-input.store-user-messages.label",defaultMessage:"Record conversation history and context to improve quality",description:"Label for the store user messages checkbox"},mobileAppSubMenuLabel:{id:"ai-mate.chat-header.mobile-app-sub-menu-label",defaultMessage:"Mobile app",description:"Label for the Mobile app item in the more menu"},mobileAppSubMenuTitle:{id:"ai-mate.chat-header.mobile-app-sub-menu-title",defaultMessage:"Mobile app",description:"Title for the Mobile app sub-menu header in the more menu"},chatHeaderSwitchSiteButtonText:{id:"ai-mate.rovo-chat-header.switch-site-button-text",defaultMessage:"Switch site",description:"Text for the header switch site button"},chatHeaderSettingsButtonText:{id:"ai-mate.rovo-chat-header.settings-button-text",defaultMessage:"Settings and memory",description:"Text for the header settings and memory button"},chatHeaderSettingsIconLabel:{id:"ai-mate.rovo-chat-header.settings-icon-label",defaultMessage:"Settings and memory",description:"Label for the header settings and memory icon"},chatHeaderWhatsNewButtonText:{id:"ai-mate.rovo-chat-header.whats-new-button-text.updated",defaultMessage:"What's new in Rovo",description:"Text for the header what's new in Rovo button"},chatHeaderWhatsNewIconLabel:{id:"ai-mate.rovo-chat-header.whats-new-icon-label.updated",defaultMessage:"What's new in Rovo",description:"Label for the header what's new in Rovo icon"},chatHeaderShareButtonText:{id:"ai-mate.rovo-chat-header.share-button-text",defaultMessage:"Share",description:"Text for the header share button that opens the share chat dialog"},chatHeaderShareIconLabel:{id:"ai-mate.rovo-chat-header.share-icon-label",defaultMessage:"Share",description:"Label for the header share icon"},chatHeaderShareDisabledTooltip:{id:"ai-mate.rovo-chat-header.share-disabled-tooltip",defaultMessage:"You can share once Rovo finishes responding",description:"Tooltip shown when the share chat button is disabled because Rovo is still generating a response. Tells the user they can share the chat after the response is complete."},chatHeaderShareMissingValidResponseDisabledTooltip:{id:"ai-mate.rovo-chat-h