		query ScenarioList($agentId: ID!, $cloudId: String!, $first: Int, $contextAri: ID!) {
			agentStudio_scenarioListByContainerId(containerId: $agentId, cloudId: $cloudId, first: $first) {
				edges {
					node {
						id
						name
						instructions
						scenarioVersion
						isDefault
						isActive
						isValid {
							value
						}
						actions {
							actionKey
        					name
							description
							iconUrl
							tags
						}
						tools {
							id
							displayName
							description
							iconUrl
							tags
						}
						knowledgeSources {
							enabled
							sources {
								enabled
								source
								`.concat((0,m.fg)("rovo_agents_unit_scoped")?"cloudId":"",`
