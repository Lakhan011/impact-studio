t do?",description:"Heading shown in the welcome banner on the landing view of the Rovo agent create modal"},createAgentError:{id:"rovo-agent-create-modal.create-agent-error",defaultMessage:"Something went wrong creating your agent. Please try again.",description:'Error flag shown when creating a blank draft agent from the "Start from blank" action fails'},loading:{id:"rovo-agent-create-modal.loading",defaultMessage:"Loading",description:"Accessible label announced while the create agent modal is loading"},startFromBlank:{id:"rovo-agent-create-modal.start-from-blank",defaultMessage:"Start from blank",description:"The text is shown on a button in the Rovo agent create modal header. When clicked, it creates a blank draft agent and opens it in Studio."},stagingAreaLoading:{id:"rovo-agent-create-modal.staging-area.loading",defaultMessage:"Setting up your new agent",description:"Title for the agent loading screen"},helpfulTipLozenge:{id:"rovo-agent-create-modal.staging-area.helpful.tip",defaultMessage:"Tip",description:"Label for the lozenge to show before a tip in the loading state"},helpfulMessageRefine:{id:"rovo-agent-create-modal.staging-area.helpful.refine",defaultMessage:"If you're looking to refine your agent, ask Rovo how to improve it.",description:"Help text for the agent loading screen"},backlogPrioritizerTitle:{id:"rovo-agent-create-modal.prompt-card.backlog-prioritizer.title",defaultMessage:"Backlog prioritizer",description:"Title of the backlog prioritizer prompt starter card in the Create Agent modal"},backlogPrioritizerPrompt:{id:"rovo-agent-create-modal.prompt-card.backlog-prioritizer.prompt",defaultMessage:"Prioritise my backlog and rank what to do next with reasons, flags items at risk, and break oversized items into smaller pieces.",description:"Prompt text for the backlog prioritizer starter card in the Create Agent modal"},capacityWorkloadBalancerTitle:{id:"rovo-agent-create-modal.prompt-card.capacity-workload-balancer.title",defaultMessage:"Capacity & workload balancer",description:"Title of the capacity and workload balancer prompt starter card in the Create Agent modal"},capacityWorkloadBalancerPrompt:{id:"rovo-agent-create-modal.prompt-card.capacity-workload-balancer.prompt",defaultMessage:"Balance capacity & workload by giving a clear read on who is over or under loaded across the team, spot concentration risk, and propose a fairer rebalance of work — applying reassignments on request.",description:"Prompt text for the capacity and workload balancer starter card in the Create Agent modal"},compliancePolicyAssistantTitle:{id:"rovo-agent-create-modal.prompt-card.compliance-policy-assistant.title",defaultMessage:"Compliance & Policy Assistant",description:"Title of the compliance and policy assistant prompt starter card in the Create Agent modal"},compliancePolicyAssistantPrompt:{id:"rovo-agent-create-modal.prompt-card.compliance-policy-assistant.prompt",defaultMessage:"Answer policy and compliance questions from my authoritative documents, and check a piece of work, request or change against the relevant rules — always citing the exact clause.",description:"Prompt text for the compliance and policy assistant starter card in the Create Agent modal"},duplicateWorkDetectorTitle:{id:"rovo-agent-create-modal.prompt-card.duplicate-work-detector.title",defaultMessage:"Duplicate work detector",description:"Title of the duplicate work detector prompt starter card in the Create Agent modal"},duplicateWorkDetectorPrompt:{id:"rovo-agent-create-modal.prompt-card.duplicate-work-detector.prompt",defaultMessage:"Search for duplicate or closely related work across Jira and Confluence before new work is created — so a new epic, work item or page doesn't reinvent something already started or finished. Add links to the closest matches.",description:"Prompt text for the duplicate work detector starter card in the Create Agent modal"},escalationHandoffTitle:{id:"rovo-agent-create-modal.prompt-card.escalation-handoff.title",defaultMessage:"Escalation Handoff",description:"Title of the escalation handoff prompt starter card in the Create Agent modal"},escalationHandoffPrompt:{id:"rovo-agent-create-modal.prompt-card.escalation-handoff.prompt",defaultMessage:"Write a clear escalation handoff from the full ticket history so the specialist team has the context it needs without re-asking the customer.",description:"Prompt text for the escalation handoff starter card in the Create Agent modal"},globalTranslatorTitle:{id:"rovo-agent-create-modal.prompt-card.global-translator.title",defaultMessage:"Global Translator",description:"Title of the global translator prompt starter card in the Create Agent modal"},globalTranslatorPrompt:{id:"rovo-agent-create-modal.prompt-card.global-translator.prompt",defaultMessage:"Help with localization for global teams by translating work faithfully, maintaining a shared glossary, and keeping translated pages in sync with their source.",description:"Prompt text for the global translator starter card in the Create Agent modal"},knowledgeCuratorTitle:{id:"rovo-agent-create-modal.prompt-card.knowledge-curator.title",defaultMessage:"Knowledge Curator",description:"Title of the knowledge curator prompt starter card in the Create Agent modal"},knowledgeCuratorPrompt:{id:"rovo-agent-create-modal.prompt-card.knowledge-curator.prompt",defaultMessage:"Turn resolved tickets into a healthier knowledge base by finding gaps, drafting missing articles for approval, and keep existing pages fresh and findable.",description:"Prompt text for the knowledge curator starter card in the Create Agent modal"},meetingToActionTitle:{id:"rovo-agent-create-modal.prompt-card.meeting-to-action.title",defaultMessage:"Meeting-to-Action Agent",description:"Title of the meeting-to-action agent prompt starter card in the Create Agent modal"},meetingToActionPrompt:{id:"rovo-agent-create-modal.prompt-card.meeting-to-action.prompt",defaultMessage:"Turn a meeting transcript or notes into structured outcomes — decisions, action items as Jira tasks with owners and due dates, a Confluence summary, and (on request) follow-up meeting invites.",description:"Prompt text for the meeting-to-action agent starter card in the Create Agent modal"},newHireOnboardingTitle:{id:"rovo-agent-create-modal.prompt-card.new-hire-onboarding.title",defaultMessage:"New Hire Onboarding",description:"Title of the new hire onboarding prompt starter card in the Create Agent modal"},newHireOnboardingPrompt:{id:"rovo-agent-create-modal.prompt-card.new-hire-onboarding.prompt",defaultMessage:"A companion for someone's first weeks — answers \"how do we do X here?\" from your team's docs, walks them through their onboarding checklist, tracks completion in Jira, and points to the right people.",description:"Prompt text for the new hire onboarding starter card in the Create Agent modal"},projectKickoffPackGeneratorTitle:{id:"rovo-agent-create-modal.prompt-card.project-kickoff-pack-generator.title",defaultMessage:"Project Kickoff Pack Generator",description:"Title of the project kickoff pack generator prompt starter card in the Create Agent modal"},projectKickoffPackGeneratorPrompt:{id:"rovo-agent-create-modal.prompt-card.project-kickoff-pack-generator.prompt",defaultMessage:"Spins up a new project from a short brief — a Confluence home page and charter, starter Jira epics, and an Atlas goal — all linked together and consistent with your team's template.",description:"Prompt text for the project kickoff pack generator starter card in the Create Agent modal"},qaHelpdeskAssistantTitle:{id:"rovo-agent-create-modal.prompt-card.qa-helpdesk-assistant.title",defaultMessage:"Q&A Helpdesk Assistant",description:"Title of the Q&A helpdesk assistant prompt starter card in the Create Agent modal"},qaHelpdeskAssistantPrompt:{id:"rovo-agent-create-modal.prompt-card.qa-helpdesk-assistant.prompt",defaultMessage:"A self-serve expert for your team that answers questions with citations, closes genuine documentation gaps, and reports on knowledge health over time.",description:"Prompt text for the Q&A helpdesk assistant starter card in the Create Agent modal"},riskBlockerTrackerTitle:{id:"rovo-agent-create-modal.prompt-card.risk-blocker-tracker.title",defaultMessage:"Risk & Blocker Tracker",description:"Title of the risk and blocker tracker prompt starter card in the Create Agent modal"},riskBlockerTrackerPrompt:{id:"rovo-agent-create-modal.prompt-card.risk-blocker-tracker.prompt",defaultMessage:"Continuously surfaces delivery risks and blockers, assesses what they threaten, maintains a living risk log, and nudges owners only with approval.",description:"Prompt text for the risk and blocker tracker starter card in the Create Agent modal"},selfPerformanceAssistantTitle:{id:"rovo-agent-create-modal.prompt-card.self-performance-assistant.title",defaultMessage:"Self-Performance Assistant",description:"Title of the self-performance assistant prompt starter card in the Create Agent modal"},selfPerformanceAssistantPrompt:{id:"rovo-agent-create-modal.prompt-card.self-performance-assistant.prompt",defaultMessage:"A private career companion that continuously assembles evidence of your impact from your own work across Jira, Confluence, PRs, goals and Loom — then helps you draft self-reviews, brag docs, promotion cases and weekly updates, mapped to your competency framework.",description:"Prompt text for the self-performance assistant starter card in the Create Agent modal"},sprintRetroFacilitatorTitle:{id:"rovo-agent-create-modal.prompt-card.sprint-retro-facilitator.title",defaultMessage:"Sprint Retro Facilitator",description:"Title of the sprint retro facilitator prompt starter card in the Create Agent modal"},sprintRetroFacilitatorPrompt:{id:"rovo-agent-create-modal.prompt-card.sprint-retro-facilitator.prompt",defaultMessage:"Auto-generates a data-backed, blameless retrospective when a sprint or epic closes — what shipped, what slipped, cycle-time outliers, recurring blockers — and creates a Confluence retro page plus follow-up actions.",description:"Prompt text for the sprint retro facilitator starter card in the Create Agent modal"},surveyFeedbackSynthesiserTitle:{id:"rovo-agent-create-modal.prompt-card.survey-feedback-synthesiser.title",defaultMessage:"Survey & Feedback Synthesiser",description:"Title of the survey and feedback synthesiser prompt starter card in the Create Agent modal"},surveyFeedbackSynthesiserPrompt:{id:"rovo-agent-create-modal.prompt-card.survey-feedback-synthesiser.prompt",defaultMessage:"Turn raw feedback — survey responses, support tickets, interview notes, comments — into themes with evidence, sentiment, and a prioritised set of recommended actions linked back to Jira.",description:"Prompt text for the survey and feedback synthesiser starter card in the Create Agent modal"}}),I=n(182929),x=function(e){var t=e.label,n=e.testId;return u.createElement("svg",{width:"16",height:"16",viewBox:"0 0 16 16",fill:"none",xmlns:"http://www.w3.org/2000/svg","aria-hidden":!t||void 0,"aria-label":t||void 0,"data-testid":n},u.createElement("g",{clipPath:"url(#manual-create-clip-0)"},u.createElement("g",{clipPath:"url(#manual-create-clip-1)"},u.createElement("g",{clipPath:"url(#manual-create-clip-2)"},u.createElement("path",{d:"M0 4C0 1.79086 1.79086 0 4 0H12C14.2091 0 16 1.79086 16 4V12C16 14.2091 14.2091 16 12 16H4C1.79086 16 0 14.2091 0 12V4Z",fill:"#DDDEE1"}),u.createElement("g",{clipPath:"url(#manual-create-clip-3)"},u.createElement("path",{fillRule:"evenodd",clipRule:"evenodd",d:"M7.0625 12.375V7.0625H12.375V12.375H7.0625ZM9.60145 8.05L9.49249 8.33565C9.33609 8.74571 9.25788 8.95073 9.1113 9.10608C8.96471 9.26143 8.76456 9.35139 8.36426 9.5313L8.2168 9.59758V9.83571L8.36418 9.90195C8.76452 10.0819 8.96469 10.1718 9.11129 10.3272C9.25789 10.4825 9.33609 10.6876 9.4925 11.0977L9.60145 11.3833H9.83218L9.94117 11.0976C10.0976 10.6876 10.1758 10.4825 10.3224 10.3272C10.469 10.1718 10.6691 10.0819 11.0694 9.90196L11.2168 9.83571V9.59758L11.0693 9.