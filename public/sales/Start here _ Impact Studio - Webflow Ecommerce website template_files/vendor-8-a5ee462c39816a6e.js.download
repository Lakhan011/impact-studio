query ConfluencePageTemplates($spaceKey: String!) {
	allTemplates(spaceKey: $spaceKey) @optIn(to: "AskInCcApiPlatformBeforeUsing") {
		nodes {
			templateId
			contentBlueprintId
			itemModuleCompleteKey
			templateType
			name
			description
			iconURL
			darkModeIconURL
			keywords
		}
	}
}
`,ru=`
query ConfluenceWhiteboardsTemplatesQuery($cloudId: ID!) {
	confluence_whiteboardTemplates(cloudId: $cloudId) {
		nodes {
			id
			name
			description
			keywords
		}
	}
}
